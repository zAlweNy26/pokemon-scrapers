{
  "name": "homedex",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "void deploy --platform cloudflare",
    "typecheck": "void prepare && tsc --noEmit",
    "test": "bun test",
    "db:generate": "void db generate",
    "db:migrate": "void db migrate",
    "db:migrate:remote": "void db migrate --remote",
    "db:seed": "void db seed --file data/seed.sql",
    "data:build": "bun src/scraper/index.ts",
    "data:check": "bun src/scraper/check.ts",
    "data:sprites": "bun src/scraper/upload-sprites.ts",
    "data:load:local": "void db seed --file data/dataset.sql",
    "data:load:remote": "wrangler d1 execute 30a87976-0a8e-4494-8c4b-eec46aaee36b --remote --yes --file data/dataset.sql"
  },
  "dependencies": {
    "@elysiajs/cors": "1.4.3",
    "@elysiajs/openapi": "1.4.17",
    "drizzle-orm": "^0.45.4",
    "elysia": "1.4.31",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "void": "1.6.2",
    "wrangler": "4.158.0"
  }
}
